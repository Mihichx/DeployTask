        <mxCell id="XymKLL2MVC7H8suhLxnA-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; margin: 0px; border-bottom: 0px rgb(232, 234, 242); color: light-dark(rgb(0, 0, 0), rgb(255, 51, 51));&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;DeployTask&lt;/font&gt;&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;&lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; margin: 0px; border-bottom: 0px rgb(232, 234, 242);&quot;&gt;&lt;font style=&quot;&quot;&gt;&lt;p style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;высокопроизводительный таск-менеджер для разработчиков и команд, спроектированный как легковесная и быстрая альтернатива Jira и ClickUp.&lt;/font&gt;&lt;/p&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
