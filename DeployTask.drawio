        <mxCell id="XymKLL2MVC7H8suhLxnA-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div class=&quot;ZLzG0d ncoeY E8xBUb&quot; role=&quot;heading&quot; aria-level=&quot;4&quot; style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; font-weight: 600; margin: 24px 0px 12px; border-bottom: 0px rgb(232, 234, 242);&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Технологический стек&lt;/font&gt;&lt;/div&gt;&lt;ul class=&quot;XSq4R KI3fJ&quot; style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif, &amp;quot;Noto Color Emoji&amp;quot;; margin: 12px 0px 16px; border-bottom: 0px rgb(232, 234, 242);&quot;&gt;&lt;li class=&quot;Z1qcYe&quot; style=&quot;margin: 0px 0px 12px; border-bottom: 0px rgb(232, 234, 242);&quot;&gt;&lt;span class=&quot;iNqyIf&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(232, 234, 242);&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(232, 234, 242);&quot;&gt;Backend:&lt;/span&gt; &lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(102, 178, 255));&quot;&gt;PHP &lt;/span&gt;8.5+ / Laravel &lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 51, 51));&quot;&gt;13 &lt;/span&gt;(Проверенная надежность, встроенные очереди, мощная ORM Eloquent)&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&quot;Z1qcYe&quot; style=&quot;margin: 0px 0px 12px; border-bottom: 0px rgb(232, 234, 242);&quot;&gt;&lt;span class=&quot;iNqyIf&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(232, 234, 242);&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(232, 234, 242);&quot;&gt;Database:&lt;/span&gt; PostgreSQL (Реляционная база данных для сложных связей и высокой нагрузки)&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&quot;Z1qcYe&quot; style=&quot;margin: 0px 0px 12px; border-bottom: 0px rgb(232, 234, 242);&quot;&gt;&lt;span class=&quot;iNqyIf&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(232, 234, 242);&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(232, 234, 242);&quot;&gt;Frontend:&lt;/span&gt; Blade + Alpine.js + Livewire (Реактивность &quot;на лету&quot; без раздувания клиентского JS-кода)&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li class=&quot;Z1qcYe&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(232, 234, 242);&quot;&gt;&lt;span class=&quot;iNqyIf&quot; aria-owns=&quot;action-menu-parent-container&quot; style=&quot;margin: 0px; border-bottom: 0px rgb(232, 234, 242);&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;span class=&quot;rQesXe MPyX&quot; style=&quot;font-weight: 700; margin: 0px; border-bottom: 0px rgb(232, 234, 242);&quot;&gt;Интеграции:&lt;/span&gt; GitHub API, Wakapi API, LLM API (GigaChat)&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
