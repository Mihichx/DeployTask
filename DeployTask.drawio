          <mxGeometry height="48" width="99" x="633" y="720" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="urySMG7XK5ue5o2GElgS" name="Библиотеки">
    <mxGraphModel dx="2575" dy="1805" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="w3IRA3xtMz-g4ncf9_Jb-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Библиотеки&lt;/font&gt;&lt;/h1&gt;&lt;div&gt;&lt;font style=&quot;&quot;&gt;&lt;div style=&quot;font-size: 18px;&quot;&gt;Основные библиотеки (для работы сайта):&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;1) laravel/framework — ядро фреймворка Laravel 13, обеспечивающее работу маршрутов, контроллеров и базы данных PostgreSQL.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;2) laravel/tinker — интерактивная консоль для выполнения PHP-кода и тестирования приложения прямо из терминала.&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;p style=&quot;font-size: 18px;&quot;&gt;Инфраструктура и производительность (Бэкенд)&lt;/p&gt;&lt;ul style=&quot;&quot;&gt;&lt;li style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;predis/predis — Интеграция с In-Memory базой данных Redis. Используется для высокоскоростного кэширования Kanban-доски, структуры воркспейсов и управления асинхронными очередями.&lt;/font&gt;&lt;/li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;li style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;guzzlehttp/guzzle — Встроенный HTTP-клиент Laravel. Отвечает за фоновую отправку запросов к сторонним сервисам (интеграция с Wakapi API и LLM API).&lt;/font&gt;&lt;/li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;li style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;strong style=&quot;&quot;&gt;laravel/sail&lt;/strong&gt; — Официальная среда развертывания на базе Docker. Изолирует стек (PHP 8.5+, PostgreSQL, Redis) в контейнерах и позволяет запустить проект одной командой.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p style=&quot;font-size: 18px;&quot;&gt;Интерфейс и Клиентский UI (Фронтенд)&lt;/p&gt;&lt;ul style=&quot;&quot;&gt;&lt;li style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;strong style=&quot;&quot;&gt;livewire/livewire&lt;/strong&gt; — Компонентный фреймворк для реализации реактивного UI без написания сложного JavaScript-кода. Обеспечивает мгновенное обновление карточек задач и комментариев (Alpine.js уже встроен).&lt;/font&gt;&lt;/li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;li style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;apexcharts (или chart.js) — Фронтенд-библиотека для рендеринга графиков. Используется на дашборде Тимлида для визуализации статистики затраченного времени из Wakapi.&lt;/font&gt;&lt;/li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;li style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;strong style=&quot;&quot;&gt;npm&lt;/strong&gt; — Стандартный менеджер пакетов для JavaScript. Используется для установки клиентских зависимостей и сборки фронтенд-ассетов (CSS и JS) через Vite.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p style=&quot;font-size: 18px;&quot;&gt;Инструменты отладки и разработки (Local Only)&lt;/p&gt;&lt;ul style=&quot;&quot;&gt;&lt;li style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;strong style=&quot;&quot;&gt;barryvdh/laravel-debugbar&lt;/strong&gt; — Панель отладки разработчика. Необходима для контроля количества SQL-запросов к PostgreSQL и предотвращения проблемы N+1 при рендере списков задач.&lt;/font&gt;&lt;/li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;li style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;laravel/telescope — Экосистема мониторинга Laravel. Понадобится для локального дебага асинхронных очередей (Jobs), отправки веб-хуков GitHub и проверки кэш-логов Redis.&lt;/font&gt;&lt;/li&gt;&lt;br&gt;&lt;li style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;strong style=&quot;&quot;&gt;buggregator/trap&lt;/strong&gt; — Локальный сервер для перехвата и отладки. Позволяет удобно просматривать отправляемые проектом email-уведомления, дампы переменных (&lt;code style=&quot;&quot;&gt;dump()&lt;/code&gt;), логи и входящие веб-хуки без настройки реальных почтовых сервисов.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="722" width="793" x="17" y="223" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
